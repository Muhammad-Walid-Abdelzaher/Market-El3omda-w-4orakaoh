# StockVision AI - Backend Environment Variables
# Copy this file to .env and fill in your values

# Database (SQLite is the default, no changes needed for development)
DATABASE_URL=sqlite:///./stockvision.db

# OpenAI API Key (required for AI Assistant feature)
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Computer Vision
YOLO_MODEL_PATH=models/best.pt
CV_CONFIDENCE_THRESHOLD=0.5

# Debug mode (set to false in production)
DEBUG=true
